            },
            "night-owl": {
                href: "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/night-owl.min.css",
                integrity: "sha384-xMH/akAd4WIJSWGsUlveLGugns8GuYeJglqHRpASAW0sSbPNVM+BIa4Xa/50+uaJ"
            }
        };

        function applyHighlightTheme(themeName) {
            const theme = HLJS_THEMES[themeName] || HLJS_THEMES["github-dark"];
            const tag = document.getElementById("hljs-theme");
            tag.href = theme.href;
            tag.integrity = theme.integrity;
            tag.crossOrigin = "anonymous";
            localStorage.setItem("kitepad_hljs_theme", themeName);
            const select = document.getElementById("theme-select");
            if (select) select.value = themeName;
        }

        // E2EE Decryption
        async function deriveKey(password, salt) {
            const encoder = new TextEncoder();
            const baseKey = await crypto.subtle.importKey(
                "raw", encoder.encode(password), "PBKDF2", false, ["deriveKey"]
            );
            return crypto.subtle.deriveKey(
                { name: "PBKDF2", salt, iterations: 100000, hash: "SHA-256" },
                baseKey, { name: "AES-GCM", length: 256 }, false, ["decrypt"]
            );
        }

        async function decryptData(base64Data, password) {
            const combined = new Uint8Array(atob(base64Data).split("").map(c => c.charCodeAt(0)));
            const salt = combined.slice(0, 16);
            const iv = combined.slice(16, 28);
            const encrypted = combined.slice(28);

            const key = await deriveKey(password, salt);
            const decrypted = await crypto.subtle.decrypt(
                { name: "AES-GCM", iv }, key, encrypted
            );
            return new TextDecoder().decode(decrypted);
        }

        async function handleDecrypt(event, id, encryptedContent) {
            event.preventDefault();
            const password = document.getElementById(`decrypt-pw-${id}`).value;
            try {
                const decrypted = await decryptData(encryptedContent, password);
                document.getElementById(`decrypt-prompt-${id}`)?.remove();
                renderContent(id, decrypted);
            } catch (e) {
                alert(tr("alert.decryptFailed", "Decryption failed. Incorrect password?"));
            }
        }

        async function handleDecryptFromAttr(event, id) {
            event.preventDefault();
            const prompt = document.getElementById(`decrypt-prompt-${id}`);
            const encryptedContent = prompt?.dataset?.encrypted;
            if (!encryptedContent) { alert('No encrypted content found.'); return; }
            const password = document.getElementById(`decrypt-pw-${id}`).value;
            try {
                const decrypted = await decryptData(encryptedContent, password);
                prompt.remove();
                renderContent(id, decrypted);
            } catch (e) {
                alert(tr("alert.decryptFailed", "Decryption failed. Incorrect password?"));
            }
        }

        function autoEmbed(html) {
            // Youtube Links (marked might turn them into anchor tags)
            html = html.replace(/<a[^>]*href="https?:\/\/(?:www\.)?youtube\.com\/watch\?v=([a-zA-Z0-9_-]+)"[^>]*>.*?<\/a>/g,
                '<div class="embed-container"><iframe width="100%" height="450" src="https://www.youtube.com/embed/$1" frameborder="0" allowfullscreen></iframe></div>');
            // Plain Youtube URLs (not inside quotes)
            html = html.replace(/(?<!["'])(https?:\/\/(?:www\.)?youtube\.com\/watch\?v=([a-zA-Z0-9_-]+))/g,
                '<div class="embed-container"><iframe width="100%" height="450" src="https://www.youtube.com/embed/$2" frameborder="0" allowfullscreen></iframe></div>');
            return html;
        }

        function scanForSecrets(text) {
            const patterns = [
                /sk-[a-zA-Z0-9]{48}/,       // OpenAI
                /AKIA[0-9A-Z]{16}/,         // AWS Access Key
                /-----BEGIN PRIVATE KEY-----/ // Generic Private Key
            ];
            return patterns.some(pattern => pattern.test(text));
        }

        function renderContent(id, content) {
            const contentDiv = document.getElementById(`content-${id}`);
            if (!contentDiv) return;

            // Secret Scanner (only for single view)
            const banner = document.getElementById('secret-banner');
            if (banner && scanForSecrets(content)) {
                banner.classList.remove('hidden');
            }

            let html = marked.parse(content);
            html = autoEmbed(html);
            contentDiv.innerHTML = DOMPurify.sanitize(html, { ADD_TAGS: ['iframe'], ADD_ATTR: ['allow', 'allowfullscreen', 'frameborder', 'scrolling'] });

            contentDiv.querySelectorAll('pre code').forEach((block) => {
                if (block.className.indexOf('language-') === -1) {
                    const result = hljs.highlightAuto(block.innerText);
                    block.innerHTML = result.value;
                } else {
                    hljs.highlightElement(block);
                }
                hljs.lineNumbersBlock(block);
            });

            renderMathInElement(contentDiv, {
                delimiters: [
                    { left: '$$', right: '$$', display: true },
                    { left: '$', right: '$', display: false },
                    { left: '\\(', right: '\\)', display: false },
                    { left: '\\[', right: '\\]', display: true }
                ],
                throwOnError: false
            });
        }

        function copyCurrentUrl() {
            const url = window.location.origin + window.location.pathname;
            navigator.clipboard.writeText(url).then(() => {
                alert(tr("alert.linkCopied", "Link copied to clipboard!"));
            });
        }

        function copyContent(elementId) {
            const element = document.getElementById(elementId);
            navigator.clipboard.writeText(element.innerText).then(() => {
                alert(tr("alert.contentCopied", "Content copied to clipboard!"));
            });
        }

        function copyText(text) {
            navigator.clipboard.writeText(text).then(() => {
                alert(tr("alert.copied", "Copied to clipboard!"));
            });
        }

        function copyShareLink(id) {
            const shareUrl = window.location.origin + '/v/' + id;
            navigator.clipboard.writeText(shareUrl).then(() => {
                alert(tr("alert.linkCopied", "Link copied to clipboard!"));
            });
        }

        let qrcodeGenerated = false;
        function toggleQRCode() {
            const wrapper = document.getElementById('qrcode-wrapper');
            if (wrapper.style.display === 'none') {
                wrapper.style.display = 'block';
                if (!qrcodeGenerated) {
                    new QRCode(document.getElementById("qrcode"), {
                        text: window.location.origin + window.location.pathname,
                        width: 150,
                        height: 150,
                        colorDark: "#000000",
                        colorLight: "#ffffff",
                        correctLevel: QRCode.CorrectLevel.H
                    });
                    qrcodeGenerated = true;
                }
            } else {
                wrapper.style.display = 'none';
            }
        }

        function toggleZenMode() {
            document.body.classList.toggle('zen-mode');
        }

        async function loadReactions(uid) {
            try {
                const res = await fetch(`/react?uid=${encodeURIComponent(uid)}`);
                if (!res.ok) return;
                const data = await res.json();
                Object.entries(data.counts || {}).forEach(([emoji, count]) => {
                    const span = document.querySelector(`.reaction-count[data-uid="${uid}"][data-emoji="${emoji}"]`);
                    if (span) span.textContent = String(count);
                });
            } catch (_) {}
        }

        async function toggleReaction(uid, emoji) {
            try {
                const res = await fetch('/react', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ uid, emoji })
                });
                if (!res.ok) return;
                const data = await res.json();
                Object.entries(data.counts || {}).forEach(([name, count]) => {
                    const span = document.querySelector(`.reaction-count[data-uid="${uid}"][data-emoji="${name}"]`);
                    if (span) span.textContent = String(count);
                });
            } catch (_) {}
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (window.KiteI18n) window.KiteI18n.init();
            const savedTheme = localStorage.getItem("kitepad_hljs_theme") || "github-dark";
            applyHighlightTheme(savedTheme);
            const themeSelect = document.getElementById("theme-select");
            if (themeSelect) {
                themeSelect.addEventListener("change", (e) => applyHighlightTheme(e.target.value));
            }
            document.querySelectorAll('[data-reaction-uid]').forEach((el) => {
                const uid = el.getAttribute('data-reaction-uid');
                loadReactions(uid);
            });
            if ("serviceWorker" in navigator) {
                navigator.serviceWorker.register("/sw.js").catch(() => {});
            }
        });
    </script>
